<Window x:Class="FreeDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeDM"
        Width="1150"
        Height="720"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <Window.Resources>

        <Style x:Key="ToolbarButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="4,0"/>
            <Setter Property="Padding"
                    Value="16,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#1976D2">

            <DockPanel Margin="20,0">

                <TextBlock Text="FreeDM"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Free Download Manager"
                           Foreground="#D7E9FA"
                           FontSize="14"
                           Margin="15,8,0,0"
                           VerticalAlignment="Center"/>

            </DockPanel>

        </Border>

        <!-- Toolbar -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9DEE3"
                BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0">

                <Button Content="＋ Add URL"
                        Style="{StaticResource ToolbarButton}"
                        Click="AddUrl_Click"/>

                <Button Content="▶ Start"
                        Style="{StaticResource ToolbarButton}"
                        Click="Start_Click"/>

                <Button Content="Ⅱ Pause"
                        Style="{StaticResource ToolbarButton}"
                        Click="Pause_Click"/>

                <Button Content="✕ Remove"
                        Style="{StaticResource ToolbarButton}"
                        Click="Remove_Click"/>

                <Separator Width="1"
                           Margin="12,5"/>

                <Button Content="📁 Open Folder"
                        Style="{StaticResource ToolbarButton}"
                        Click="OpenFolder_Click"/>

            </StackPanel>

        </Border>

        <!-- Downloads -->

        <Border Grid.Row="2"
                Margin="12"
                Background="White"
                BorderBrush="#D9DEE3"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding Downloads}"
                      SelectedItem="{Binding SelectedDownload}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="File"
                                        Binding="{Binding FileName}"
                                        Width="240"/>

                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding Size}"
                                        Width="110"/>

                    <DataGridTemplateColumn Header="Progress"
                                            Width="180">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid Margin="6">

                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding Progress}"
                                        Height="16"/>

                                    <TextBlock
                                        Text="{Binding Progress,
                                               StringFormat={}{0:0}%}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"/>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Speed"
                                        Binding="{Binding Speed}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="130"/>

                    <DataGridTextColumn Header="URL"
                                        Binding="{Binding Url}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- Status -->

        <Border Grid.Row="3"
                Background="#E5E9ED">

            <TextBlock Text="{Binding StatusText}"
                       Margin="12,7"
                       Foreground="#555555"/>

        </Border>

    </Grid>

</Window>
